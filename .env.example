PLATFORMOPS_LOCAL_MODE=false
PLATFORMOPS_LLM_PROVIDER=mistral
PLATFORMOPS_LLM_API_KEY=
PLATFORMOPS_MISTRAL_API_KEY=
PLATFORMOPS_MISTRAL_API_KEY_FILE=
PLATFORMOPS_LLM_MODEL=mistral-small-2506
PLATFORMOPS_GROQ_API_KEY=
PLATFORMOPS_GROQ_MODEL=llama-3.1-8b-instant
PLATFORMOPS_LLM_MAX_LOGS=1000
PLATFORMOPS_LLM_MAX_TAIL_LOGS=500
PLATFORMOPS_LLM_TIMEOUT=120
# Isolated Compose defaults (the live cPlatform stack remains on 9002).
PLATFORMOPS_PUBLIC_BASE_URL=http://localhost:9020
PLATFORMOPS_DATABASE_URL=postgresql+psycopg://platformops:platformops@postgres:5432/platformops
PLATFORMOPS_BOOTSTRAP_ADMIN_EMAIL=admin
PLATFORMOPS_BOOTSTRAP_ADMIN_PASSWORD=admin
PLATFORMOPS_BOOTSTRAP_ADMIN_NAME=admin
PLATFORMOPS_GLITCHTIP_TOKEN=
PLATFORMOPS_GLITCHTIP_BASE_URL=http://glitchtip:8000
PLATFORMOPS_GLITCHTIP_SECRET_KEY=platformops-isolated-development-only
PLATFORMOPS_PROMETHEUS_BASE_URL=http://prometheus:9090
PLATFORMOPS_LOKI_BASE_URL=http://loki:3100
PLATFORMOPS_LOKI_WRITE_URL=http://loki:3100
PLATFORMOPS_SMTP_HOST=mailpit
PLATFORMOPS_SMTP_PORT=1025
PLATFORMOPS_E2E_BASE=http://localhost:9020
PLATFORMOPS_ISOLATED_PROJECT=platformops-isolated
PLATFORMOPS_ISOLATED_IMAGE=platformops:isolated
PLATFORMOPS_POSTGRES_USER=platformops
PLATFORMOPS_POSTGRES_PASSWORD=platformops
PLATFORMOPS_POSTGRES_DB=platformops
PLATFORMOPS_RABBITMQ_USER=admin
PLATFORMOPS_RABBITMQ_PASSWORD=admin
