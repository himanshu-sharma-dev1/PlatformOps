    "title": "Iktara AIOrchestrator Config",
    "description": "Iktara AIOrchestrator Config Schema",
    "type": "object",
    "required": [
      "service_name",
      "service_ip",
      "service_port",
      "max_cpu",
      "max_gpu"
    ],
