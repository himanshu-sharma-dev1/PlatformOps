    "type": "object",
    "required": [
      "service_name",
      "service_port",
      "service_install",
      "service_version",
      "service_debug"
    ],
    "properties": {
      "service_name": {
        "type": "string",
        "default": ""
      },
      "service_port": {
        "type": "number",
        "default": 9085
      },
      "service_install": {
        "type": "string",
        "enum": ["MANUAL", "ANSIBLE"],
        "default": "ANSIBLE"
      },
      "service_version": {
        "type": "string",
        "default": "1.0.0"
      },
      "service_debug": {
        "type": "string",
        "enum": ["DISABLE", "INFO", "DEBUG"],
        "default": "DISABLE"
