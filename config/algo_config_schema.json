{
  "$id": "/cPlatform/Schemas/algo_config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Interface Definition between orchestrator and Training Subsystem",
  "LR_Config": {
    "title": "LR Algorithm Config",
    "description": "LR Algorithm Configuration Schema",
    "type": "object",
    "required": [
      "Enable",
      "Interpretation",
      "fea_conf_col",
      "LR_Base_Odds",
      "LR_Base_Score",
      "LR_Score_To_Double",
      "LR_Option_Penalty",
      "Training_Cycle",
      "Null_Threshold",
      "Null_Handling_Policy"
    ],
    "properties": {
      "Enable": {
        "description": "A unique identifier for a training model",
        "type": "string",
        "items": {
          "type": "string",
          "enum": [
            "True",
            "False"
          ]
        }
      },
      "Interpretation": {
        "description": "A unique identifier for a training model",
        "type": "string",
        "items": {
          "type": "string",
          "enum": [
            "True",
            "False"
          ]
        }
      },
      "fea_conf_col": {
        "type": "string"
      },
      "Null_Threshold": {
        "type": "integer",
        "default": 50,
        "minimum": 10,
        "maximum": 95
      },
      "Null_Handling_Policy": {
        "type": "string",
        "default": "Feature-Drop",
        "items": {
          "type": "string",
          "enum": [
            "Feature-Drop",
            "Halt_Training",
            "No-Action"
          ]
        }
      },
      "LR_Base_Odds": {
        "description": "Odd Ration for Base Score, e.g. 50:1",
        "type": "integer",
        "default": 50,
        "minimum": 20,
        "maximum": 80
      },
      "LR_Base_Score": {
        "type": "integer",
        "default": 600,
        "minimum": 200,
        "maximum": 1000
      },
      "LR_Score_To_Double": {
        "type": "integer",
        "default": 20,
        "minimum": 5,
        "maximum": 100
      },
      "LR_Option_Penalty": {
        "type": "string",
        "items": {
          "type": "string",
          "enum": [
            "l2",
            "l1",
            "No-elasticnet"
          ]
        },
        "default": "l2"
      },
      "num_iterations": {
        "type": "integer",
        "default": 100,
        "minimum": 2,
        "maximum": 10000
      },
      "additionalProperties": "false",
      "Training_Cycle": {
        "type": "integer",
        "default": 10000
      }
    }
  },
