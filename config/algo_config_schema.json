        "items": {
          "type": "string",
          "enum": [
            "dart",
            "gbdt",
            "rf"
          ]
        }
      },
      "num_leaves": {
        "type": "integer",
        "default": 31,
        "minimum": 2,
        "maximum": 131072
      },
      "learning_rate": {
        "type": "number",
        "default": 0.1,
        "minimum": 0.001,
        "maximum": 0.999
