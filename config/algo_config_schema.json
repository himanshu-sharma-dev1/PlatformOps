        }
      },
      "Null_Threshold": {
        "type": "integer",
        "default": 50,
        "minimum": 10,
        "maximum": 95
      },
      "Null_Handling_Policy": {
        "type": "string",
        "default": "Feature-Drop",
        "items": {
          "type": "string",
          "enum": [
            "Feature-Drop",
            "Halt_Training",
            "No-Action"
          ]
        }
      },
      "boosting_type": {
        "type": "string",
