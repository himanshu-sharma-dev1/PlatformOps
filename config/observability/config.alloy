loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

loki.process "docker_enrich" {
  forward_to = [loki.write.default.receiver]

  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "bootstrap_too_old"
  }

  stage.drop {
    longer_than         = "256KB"
    drop_counter_reason = "bootstrap_too_long"
  }

  stage.static_labels {
    values = {
      environment = "validation",
      node_id     = "NODE1001",
      node_ip     = "216.48.189.217",
      source_type = "docker_container",
    }
  }
}

loki.process "file_guard" {
  forward_to = [loki.write.default.receiver]

  stage.drop {
    longer_than         = "256KB"
    drop_counter_reason = "file_too_long"
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    replacement  = "validation"
    target_label = "environment"
  }

  rule {
    replacement  = "NODE1001"
    target_label = "node_id"
  }

  rule {
    replacement  = "216.48.189.217"
    target_label = "node_ip"
  }

  rule {
    replacement  = "docker_container"
    target_label = "source_type"
  }
}

local.file_match "cplatform_logs" {
  path_targets = [{
    __path__     = "/host-volume/iktara/cPlatform/logs/*.log*",
    service_name = "cPlatform",
    service_type = "AIOrchestrator",
    environment  = "validation",
    source_type  = "file",
  }]
}
