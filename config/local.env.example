DJANGO_SECRET_KEY=django-insecure-platformops-example-key
DJANGO_DEBUG=True

# DATABASE CONFIGURATION
DB_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# REDIS CONFIGURATION
REDIS_HOST=redis
REDIS_PORT=6379

# RABBITMQ CONFIGURATION
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
celery_app=cPlatform
celery_broker=amqp://admin:admin@rabbitmq:5672//

# PROMETHEUS CONFIGURATION
PROMETHEUS_SERVER_IP=127.0.0.1
PROMETHEUS_SERVER_PORT=9010

# LOKI CONFIGURATION
CPLATFORM_DIAGNOSTICS_LOKI_URL=http://platformops_loki:3100
CPLATFORM_DIAGNOSTICS_LOKI_INGEST_URL=http://127.0.0.1:9011

# GLITCHTIP CONFIGURATION
GLITCHTIP_ENABLED=true
GLITCHTIP_DSN=
SENTRY_DSN=
CPLATFORM_GLITCHTIP_BASE_URL=http://platformops_glitchtip_web:8000
CPLATFORM_GLITCHTIP_TOKEN=
CPLATFORM_GLITCHTIP_ORG_SLUG=platformops

# LLM & AI ASSISTANT CONFIGURATION
CPLATFORM_GROQ_API_KEY=
CPLATFORM_GROQ_MODEL=llama-3.1-8b-instant
CPLATFORM_LLM_PROVIDER=mistral
CPLATFORM_LLM_API_KEY=
CPLATFORM_LLM_MODEL=mistral-medium-2508
CPLATFORM_LLM_MAX_LOGS=1000
CPLATFORM_LLM_MAX_TAIL_LOGS=500
CPLATFORM_LLM_TIMEOUT=120
