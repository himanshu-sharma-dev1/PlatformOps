{
  "$id": "/cPlatform/Schemas/model_config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Interface Definition between orchestrator and Training Subsystem",
  "Airtel_Dataset_Config": {
    "title": "Airtel_Dataset Config",
    "description": "Airtel_Dataset Configuration Schema",
    "type": "object",
    "required": [
      "Oem",
      "Circle_List",
      "Parameter_List",
      "Date",
      "Aggr_Level",
      "Aggr_Function",
      "fea_conf_col"
    ],
    "properties": {
      "Oem": {
        "description": "",
        "type": "string",
        "list_function": "getParameterList()",
        "default": "",
        "items": {
          "type": "string",
          "enum": []
        }
      },
      "Circle_List": {
        "description": "",
        "type": "string",
        "list_function": "showCircles",
        "default": "",
        "items": {
          "type": "string",
          "enum": []
        }
      },
      "Parameter_List": {
        "description": "",
        "type": "string",
        "list_function": "showParams",
        "items": {
          "type": "string",
          "enum": []
        }
      },
      "Date": {
        "description": "",
        "type": "date"
      },
      "Aggr_Level": {
        "description": "",
        "type": "string",
        "list_function": "",
        "items": {
          "type": "string",
          "default": "Hour",
          "enum": [
            "Hour",
            "Daily",
            "Raw"
          ]
        }
      },
      "Aggr_Function": {
        "description": "",
        "type": "string",
        "list_function": "",
        "items": {
          "type": "string",
          "default": "AVG",
          "enum": [
            "MIN",
            "MAX",
            "AVG",
            "SUM"
          ]
        }
      },
      "fea_conf_col": {
        "description": "",
        "type": "string"
      },
      "additionalProperties": "false"
    }
  },
