  "Config_List": {
    "title": "",
    "description": "Algo Mapping Configuration",
    "type": "object",
    "required": [
      "Dataset"
    ],
    "properties": {
      "Dataset": {
        "type": "string",
        "description": "",
        "items": {
          "type": "string",
          "enum": [
            "Airtel_Dataset",
            "Custom_Dataset",
            "Internal_Dataset",
            "External_Dataset",
            "DB_Pull_Dataset"
          ]
        }
      },
      "Custom_Dataset" : {
        "type": "string",
        "description": "List of Algorithms for Custom_Dataset",
        "items": {
          "type": "string",
          "enum": [
            "FTP",
            "S3",
            "LOCAL",
            "SFTP"
          ]
        },
        "uniqueItems": "true"
      },
      "External_Dataset" : {
        "type": "string",
        "description": "List of Algorithms for Custom_Dataset",
        "items": {
          "type": "string",
          "enum": [
            "FTP",
            "S3",
            "LOCAL",
            "SFTP"
          ]
        },
        "uniqueItems": "true"
      },
      "DB_Pull_Dataset" : {
        "type": "string",
        "description": "List of Algorithms for Custom_Dataset",
        "items": {
          "type": "string",
          "enum": [
            "Airtel_TAW",
            "GenAI"
          ],
          "oneOf": [
            "Circle_List"
          ]
        },
        "uniqueItems": "true"
      },
      "Internal_Dataset" : {
        "type": "string",
        "description": "List of Algorithms for Custom_Dataset",
        "items": {
          "type": "string",
          "enum": [
            "Airtel_TAW",
            "GenAI"
          ],
          "oneOf": [
            "Circle_List",
            "Parameter_List",
            "Date",
            "Aggr_Level",
            "Aggr_Function"
          ]
        },
        "uniqueItems": "true"
      },

      "additionalProperties": "false"
    }
  },
