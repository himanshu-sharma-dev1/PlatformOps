{
  "TabConfig": {
    "group_con": "form-group",
    "e_type": "dynamicRow",
    "e_display": true,
    "e_name": "tabs_config",
    "row_Schema": [
      {
        "f_display_name": "TabName",
        "f_name": "tab_name",
        "f_type": "text",
        "f_required": true,
        "f_display": true,
        "f_width": 3,
        "v_default": "",
        "a_onChange": "window.forms.dFormDefaultFunc(event)"
      },
      {
        "f_display_name": "TabKey",
        "f_name": "tab_key",
        "f_type": "text",
        "f_required": true,
        "f_display": true,
        "f_width": 2,
        "v_default": ""
      },
      {
        "f_display_name": "DisplayType",
        "f_name": "display_type",
        "f_type": "single_select",
        "f_required": true,
        "f_display": true,
        "f_width": 2,
        "v_default": "form",
        "v_options": ["form", "table", "card", "custom"]
      },
      {
        "f_display_name": "TabType",
        "f_name": "tab_type",
        "f_type": "single_select",
        "f_required": true,
        "f_display": true,
        "f_width": 2,
        "v_options": ["Static", "Dynamic"]
      },
      {
        "f_display_name": "IsVisible",
        "f_name": "is_visible",
        "f_type": "single_select",
        "f_required": true,
        "f_display": true,
        "f_width": 2,
        "v_default": "Yes",
        "v_options": ["Yes", "No"]
      }
    ]
  },

