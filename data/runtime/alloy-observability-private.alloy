discovery.docker "platformops_dind" {
  host = "tcp://docker-engine:2375"
}

discovery.relabel "platformops_logs" {
  targets = discovery.docker.platformops_dind.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "compose_service"
  }
}

loki.source.docker "platformops_logs" {
  host = "tcp://docker-engine:2375"
  targets = discovery.relabel.platformops_logs.output
  forward_to = [loki.process.platformops_logs.receiver]
}

loki.process "platformops_logs" {
  forward_to = [loki.write.private_loki.receiver]

  stage.drop {
    older_than = "24h"
    drop_counter_reason = "line_too_old"
  }
}

loki.write "private_loki" {
  endpoint {
    url = "http://platformops-obs-loki:3100/loki/api/v1/push"
  }
}
