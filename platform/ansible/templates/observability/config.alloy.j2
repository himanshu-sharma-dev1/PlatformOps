loki.write "default" {
  endpoint {
    url = "http://180.75.0.43:3100/loki/api/v1/push"
  }
}

loki.process "docker_enrich" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      environment = "{{ observability_environment }}",
      node_id     = "{{ observability_node_id }}",
      node_ip     = "{{ observability_node_ip }}",
      source_type = "docker_container",
    }
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    replacement  = "{{ observability_environment }}"
    target_label = "environment"
  }

  rule {
    replacement  = "{{ observability_node_id }}"
    target_label = "node_id"
  }

  rule {
    replacement  = "{{ observability_node_ip }}"
    target_label = "node_ip"
  }

  rule {
    replacement  = "docker_container"
    target_label = "source_type"
  }
}

loki.source.file "cplatform" {
  targets       = local.file_match.cplatform_logs.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = true
}

loki.source.file "optioncopilot" {
  targets       = local.file_match.optioncopilot_logs.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = true
}

loki.source.file "dtrain" {
  targets       = local.file_match.dtrain_logs.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = false
}

loki.source.file "dinfer" {
  targets       = local.file_match.dinfer_logs.targets
  forward_to    = [loki.write.default.receiver]
