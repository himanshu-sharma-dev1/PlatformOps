local.file_match "cplatform_logs" {
  path_targets = [{
    __path__     = "/var/log/cplatform/*.log*",
    service_name = "cPlatform",
    service_type = "AIOrchestrator",
    environment  = "{{ observability_environment }}",
    source_type  = "file",
  }]
}

