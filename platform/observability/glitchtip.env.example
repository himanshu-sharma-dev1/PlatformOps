SECRET_KEY=change-me-before-deploy
PORT=8000
GLITCHTIP_DOMAIN=https://glitchtip.example.com
DEFAULT_FROM_EMAIL=glitchtip@example.com
ENABLE_OPEN_USER_REGISTRATION=False
EMAIL_URL=
# Optional SMTP-style alternative if EMAIL_URL is not used
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
GLITCHTIP_INSTANCE_NAME=Iktara Observability
ACCOUNT_EMAIL_SUBJECT_PREFIX=[Iktara Observability]
SESSION_COOKIE_NAME=glitchtip_sessionid
CSRF_COOKIE_NAME=glitchtip_csrftoken
GRANIAN_STATIC_PATH_EXPIRES=0
GLITCHTIP_IFRAME_EMBED_ENABLED=False
# Comma-separated list of external ancestor origins. 'self' is added automatically when iframe mode is enabled.
GLITCHTIP_IFRAME_ANCESTORS=
# Add cPlatform origins when embedding across origin/port, e.g. http://cplatform.example.com,https://cplatform.example.com
GLITCHTIP_IFRAME_CSRF_TRUSTED_ORIGINS=
