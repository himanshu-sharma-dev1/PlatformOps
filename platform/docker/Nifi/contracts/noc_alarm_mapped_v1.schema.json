{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cplatform.local/contracts/noc-alarm-mapped.v1.schema.json",
  "title": "cPlatform mapped alarm request v1",
  "description": "One multi-vendor alarm row after the HTTP NiFi flow has mapped vendor CSV names to the AgenticNOC alarm contract. Delivery metadata is retained for traceability; AgenticNOC still owns alarm classification and incident policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "vendor",
    "source_system",
    "source_file",
    "source_row",
    "event_id",
    "alarm_key",
    "external_alarm_id",
    "event_description",
    "site_id",
    "severity",
    "state",
    "event_type",
    "canonical_category",
    "source_event_time",
    "ingested_at",
    "AlarmID",
    "Site",
    "Severity",
    "State",
    "AlarmName",
    "Raised"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "contract": { "type": "string", "const": "noc-alarm-mapped.v1" },
    "vendor": { "type": "string", "enum": ["aviat", "cambium", "radwin", "ceragon"] },
    "source_system": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_file": { "type": "string", "maxLength": 512 },
    "source_row": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 192 },
    "alarm_key": { "type": "string", "minLength": 1, "maxLength": 192 },
    "external_alarm_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_description": { "type": "string", "maxLength": 512 },
    "object": { "type": "string", "maxLength": 512 },
    "site_id": { "type": "string", "maxLength": 128 },
    "node_id": { "type": ["string", "null"], "maxLength": 128 },
    "severity": {
      "type": "string",
      "enum": ["critical", "major", "minor", "warning", "indeterminate", "cleared"]
    },
    "state": { "type": "string", "enum": ["active", "cleared", "acknowledged"] },
    "event_type": { "type": "string", "enum": ["raise", "update", "clear"] },
    "canonical_category": { "type": "string", "minLength": 1, "maxLength": 64 },
    "probable_cause_raw": { "type": "string", "maxLength": 512 },
    "specific_problem": { "type": "string", "maxLength": 512 },
    "source_event_time": { "type": ["string", "null"], "format": "date-time" },
    "effective_event_time": { "type": ["string", "null"], "format": "date-time" },
    "device_raised_at": { "type": ["string", "null"], "format": "date-time" },
    "device_cleared_at": { "type": ["string", "null"], "format": "date-time" },
    "nms_cleared_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "maxLength": 192 },
    "stream_id": { "type": "string", "maxLength": 128 },
    "replay_cycle_id": { "type": "string", "maxLength": 128 },
    "replay_sequence": { "type": ["integer", "null"], "minimum": 0 },
    "Circle": { "type": "string", "maxLength": 64 },
    "Cleared": { "type": ["string", "null"] },
    "SpecificProblem": { "type": "string", "maxLength": 512 },
    "ProbableCause": { "type": "string", "maxLength": 512 },
    "AlarmID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Site": { "type": "string", "maxLength": 128 },
    "Severity": { "type": "string", "maxLength": 32 },
    "State": { "type": "string", "maxLength": 64 },
    "AlarmName": { "type": "string", "maxLength": 512 },
    "Raised": { "type": ["string", "null"] }
  }
}
