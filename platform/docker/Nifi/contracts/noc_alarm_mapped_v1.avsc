{
  "type": "record",
  "name": "NocAlarmMapped",
  "namespace": "ai.iktara.noc.alarm",
  "doc": "cPlatform mapped alarm record v1 for NiFi ValidateRecord processor",
  "fields": [
    { "name": "schema_version", "type": "int", "default": 1 },
    { "name": "contract", "type": "string", "default": "noc-alarm-mapped.v1" },
    { "name": "vendor", "type": "string", "default": "aviat" },
    { "name": "source_system", "type": ["null", "string"], "default": null },
    { "name": "source_file", "type": ["null", "string"], "default": null },
    { "name": "source_row", "type": ["null", "int"], "default": 1 },
    { "name": "event_id", "type": "string" },
    { "name": "alarm_key", "type": "string" },
    { "name": "external_alarm_id", "type": ["null", "string"], "default": null },
    { "name": "event_description", "type": ["null", "string"], "default": null },
    { "name": "object", "type": ["null", "string"], "default": null },
    { "name": "site_id", "type": ["null", "string"], "default": null },
    { "name": "node_id", "type": ["null", "string"], "default": null },
    { "name": "severity", "type": "string", "default": "indeterminate" },
    { "name": "state", "type": "string", "default": "active" },
    { "name": "event_type", "type": "string", "default": "raise" },
    { "name": "canonical_category", "type": ["null", "string"], "default": "UNKNOWN" },
    { "name": "probable_cause_raw", "type": ["null", "string"], "default": null },
    { "name": "specific_problem", "type": ["null", "string"], "default": null },
    { "name": "source_event_time", "type": ["null", "string"], "default": null },
    { "name": "effective_event_time", "type": ["null", "string"], "default": null },
    { "name": "device_raised_at", "type": ["null", "string"], "default": null },
    { "name": "device_cleared_at", "type": ["null", "string"], "default": null },
    { "name": "nms_cleared_at", "type": ["null", "string"], "default": null },
    { "name": "ingested_at", "type": "string" },
    { "name": "trace_id", "type": ["null", "string"], "default": null },
    { "name": "stream_id", "type": ["null", "string"], "default": null },
    { "name": "replay_cycle_id", "type": ["null", "string"], "default": null },
    { "name": "replay_sequence", "type": ["null", "int"], "default": null },
    { "name": "Circle", "type": ["null", "string"], "default": null },
    { "name": "Cleared", "type": ["null", "string"], "default": null },
    { "name": "SpecificProblem", "type": ["null", "string"], "default": null },
    { "name": "ProbableCause", "type": ["null", "string"], "default": null },
    { "name": "AlarmID", "type": ["null", "string"], "default": null },
    { "name": "Site", "type": ["null", "string"], "default": null },
    { "name": "Severity", "type": ["null", "string"], "default": null },
    { "name": "State", "type": ["null", "string"], "default": null },
    { "name": "AlarmName", "type": ["null", "string"], "default": null },
    { "name": "Raised", "type": ["null", "string"], "default": null }
  ]
}
