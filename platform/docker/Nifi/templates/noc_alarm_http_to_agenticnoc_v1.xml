<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Additive NiFi template for the HTTP alarm ingress.  The JSON manifest next
  to this file is the reviewable contract/source of truth; this XML is a
  portable NiFi import artifact with no reference to the legacy Kafka flow.
-->
<template encoding-version="1.3">
  <description>POST one mapped multi-vendor alarm row from ListenHTTP to AgenticNOC. Validation, duplicate, and failure paths are retained in the DLQ.</description>
  <groupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</groupId>
  <name>noc_alarm_http_to_agenticnoc_v1</name>
  <snippet>
    <processors>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60101</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>0.0</x><y>0.0</y></position><name>ListenHTTP /aviat row ingress</name><type>org.apache.nifi.processors.standard.ListenHTTP</type><state>STOPPED</state><config><properties><entry><key>Listening Port</key><value>9080</value></entry><entry><key>Base Path</key><value>aviat</value></entry><entry><key>HTTP Headers for Attributes</key><value>^(X-Original-Filename|X-Row-Number|X-Replay-Cycle-ID|X-Replay-Sequence|X-Vendor|X-Source-System)$</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60201</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>280.0</x><y>0.0</y></position><name>Parse one CSV row</name><type>org.apache.nifi.processors.standard.ConvertRecord</type><state>STOPPED</state><config><properties><entry><key>Record Reader</key><value>noc-http-csv-reader</value></entry><entry><key>Record Writer</key><value>noc-http-json-writer</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60301</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>560.0</x><y>0.0</y></position><name>Enforce one record per FlowFile</name><type>org.apache.nifi.processors.standard.SplitRecord</type><state>STOPPED</state><config><properties><entry><key>Record Reader</key><value>noc-http-json-reader</value></entry><entry><key>Record Writer</key><value>noc-http-json-writer</value></entry><entry><key>Records Per Split</key><value>1</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60401</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>840.0</x><y>0.0</y></position><name>Map to noc-alarm-mapped.v1</name><type>org.apache.nifi.processors.jolt.JoltTransformJSON</type><state>STOPPED</state><config><properties><entry><key>Jolt Transform</key><value>jolt-transform-chain</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60501</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>980.0</x><y>0.0</y></position><name>Add deterministic identity and delivery metadata</name><type>org.apache.nifi.processors.groovyx.ExecuteGroovyScript</type><state>STOPPED</state><config><properties><entry><key>Script Body</key><value>See noc_alarm_http_to_agenticnoc_v1.flow.json canonicalization script.</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60601</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1120.0</x><y>0.0</y></position><name>Validate mapped alarm contract</name><type>org.apache.nifi.processors.standard.ValidateRecord</type><state>STOPPED</state><config><properties><entry><key>Record Reader</key><value>noc-http-json-reader</value></entry><entry><key>Record Writer</key><value>noc-http-json-writer</value></entry><entry><key>Schema Access Strategy</key><value>Use Schema Text</value></entry><entry><key>Schema Text</key><value>#{Mapped Alarm Schema}</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60651</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1260.0</x><y>0.0</y></position><name>Extract duplicate identity attributes</name><type>org.apache.nifi.processors.standard.EvaluateJsonPath</type><state>STOPPED</state><config><properties><entry><key>Destination</key><value>flowfile-attribute</value></entry><entry><key>Return Type</key><value>scalar</value></entry><entry><key>event_id</key><value>$.event_id</value></entry><entry><key>alarm_key</key><value>$.alarm_key</value></entry><entry><key>external_alarm_id</key><value>$.external_alarm_id</value></entry><entry><key>source_file</key><value>$.source_file</value></entry><entry><key>source_row</key><value>$.source_row</value></entry><entry><key>stream_id</key><value>$.stream_id</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60701</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1400.0</x><y>0.0</y></position><name>Route duplicate alarm rows</name><type>org.apache.nifi.processors.standard.DetectDuplicate</type><state>STOPPED</state><config><properties><entry><key>Cache Entry Identifier</key><value>${stream_id}:${replay_cycle_id}:${source_file}:${source_row}</value></entry><entry><key>Distributed Cache Service</key><value>noc-http-duplicate-cache</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60801</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1680.0</x><y>-180.0</y></position><name>Duplicate metric route</name><type>org.apache.nifi.processors.attributes.UpdateAttribute</type><state>STOPPED</state><config><properties><entry><key>noc.route</key><value>duplicate</value></entry><entry><key>noc.metric</key><value>noc_http_alarm_duplicates_total</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60901</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1680.0</x><y>0.0</y></position><name>POST canonical alarm to AgenticNOC</name><type>org.apache.nifi.processors.standard.InvokeHTTP</type><state>STOPPED</state><config><properties><entry><key>HTTP Method</key><value>POST</value></entry><entry><key>HTTP URL</key><value>#{AgenticNOC Ingest URL}</value></entry><entry><key>Request Content-Type</key><value>application/json</value></entry><entry><key>Request Body Enabled</key><value>true</value></entry><entry><key>X-AgenticNOC-Vendor</key><value>${http.headers.X-Vendor:orElse('aviat')}</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60a01</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1960.0</x><y>0.0</y></position><name>Route AgenticNOC response</name><type>org.apache.nifi.processors.standard.RouteOnAttribute</type><state>STOPPED</state><config><properties><entry><key>accepted</key><value>${invokehttp.status.code:startsWith('2')}</value></entry><entry><key>rejected</key><value>${invokehttp.status.code:matches('4.*')}</value></entry><entry><key>unavailable</key><value>${invokehttp.status.code:matches('5.*') || invokehttp.status.code:isEmpty()}</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60b01</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>2240.0</x><y>-120.0</y></position><name>Accepted metric route</name><type>org.apache.nifi.processors.attributes.UpdateAttribute</type><state>STOPPED</state><config><properties><entry><key>noc.route</key><value>accepted</value></entry><entry><key>noc.metric</key><value>noc_http_alarm_posts_total</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60c01</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1680.0</x><y>280.0</y></position><name>DLQ metric route</name><type>org.apache.nifi.processors.attributes.UpdateAttribute</type><state>STOPPED</state><config><properties><entry><key>noc.route</key><value>dlq</value></entry><entry><key>noc.metric</key><value>noc_http_alarm_dlq_total</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60d01</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>1960.0</x><y>280.0</y></position><name>Persist failed alarm to DLQ</name><type>org.apache.nifi.processors.standard.PutFile</type><state>STOPPED</state><config><properties><entry><key>Directory</key><value>#{DLQ Directory}</value></entry><entry><key>Conflict Resolution Strategy</key><value>replace</value></entry></properties></config></processor>
      <processor><id>8f1bc8d4-7c8e-4f20-9e89-0f91e5e60e01</id><parentGroupId>8f1bc8d4-7c8e-4f20-9e89-0f91e5e6a101</parentGroupId><position><x>2240.0</x><y>280.0</y></position><name>RespondToHTTP</name><type>org.apache.nifi.processors.standard.HandleHttpResponse</type><state>STOPPED</state><config><properties><entry><key>HTTP Context Map</key><value>http-context-map</value></entry><entry><key>HTTP Status Code</key><value>${http.status.code:orElse('202')}</value></entry></properties></config></processor>
    </processors>
